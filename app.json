{
  "expo": {
    "name": "GHOST MODE",
    "slug": "ghost-mode",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "android": {
      "package": "com.sellurway.ghostmode",
      "permissions": []
    },
    "ios": {
      "bundleIdentifier": "com.sellurway.ghostmode",
      "supportsTablet": true
    },
    "splash": {
      "backgroundColor": "#08090D"
    }
  }
}
